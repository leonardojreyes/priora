    "test": "vitest run",
    "openapi": "node dist/generar-openapi.js"
  },
  "devDependencies": {
    "@nestjs/testing": "12.6.2",
    "@priora/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "22.19.1",
    "@types/pg": "8.15.6",
    "typescript": "6.0.3",
    "vitest": "5.1.2"
  },
  "dependencies": {
    "@nestjs/common": "12.6.2",
    "@nestjs/core": "12.6.2",
    "@nestjs/platform-express": "12.6.2",
    "@nestjs/swagger": "12.1.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
