# Plantilla de variables de entorno de Priora (se versiona). Nunca pongas secretos reales aquí.
# Desarrollo nativo: `pnpm db:init` genera `.env.local` con las URLs y claves (no se versiona).
# Significado de cada variable: docs/fase0/variables-de-entorno.md

# --- Aplicación ---
API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- PostgreSQL local ---
PGHOST=127.0.0.1
PGPORT=5432
# Una URL por rol; las escribe `pnpm db:init`.
DATABASE_URL_MIGRATOR=
DATABASE_URL_APP=
DATABASE_URL_TEST=

# --- Identidad (Keycloak local) ---
KEYCLOAK_PORT=8180
OIDC_ISSUER_URL=http://127.0.0.1:8180/realms/priora
OIDC_CLIENT_ID=priora-web
OIDC_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=priora-admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_LOG_LEVEL=info
